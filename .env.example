# 手元の開発用の設定。このファイルを .env という名前で写して使う（.env は Git に入れない）
#   cp .env.example .env
# docker compose（箱）用の設定は別ファイル deploy.env.example（→ deploy.env）にある

# Cookie の署名鍵。空なら起動のたびにランダムな鍵が作られる（再起動するとログインが外れる）
SECRET_KEY=

# 手元では development（production にすると SECRET_KEY が必須になり、/docs が出なくなる）
APP_ENV=development

# 手元の http://127.0.0.1:8000 で試すので 0
COOKIE_SECURE=0
