# このファイルを .env という名前で写して使う（.env は Git に入れない）
#   cp .env.example .env

# Cookie に署名する鍵。ながいランダムな文字列にする。例：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development / production。トンネル経由で公開するときは production
# （production では SECRET_KEY が無いと起動しない。/docs も出ない）
APP_ENV=production

# 1 にすると、セッション Cookie を HTTPS のときだけ送る。
# トンネル経由（https）なら 1。手元で http://127.0.0.1:8000 を直接開いて試すときは 0
COOKIE_SECURE=1

# DB の場所。今は SQLite のファイル（箱の中の /app/data。PC の data/ につながる）。
# Azure では postgresql+psycopg://... に変える
DATABASE_URL=sqlite:////app/data/app.db

# 待ち受けるポート（Azure では Azure が決める）
PORT=8000

# プロキシヘッダーを信じる相手。* はすべて。
# アプリのポートが PC の中にしか開いていない（127.0.0.1 だけ）ので * でよい
FORWARDED_ALLOW_IPS=*
